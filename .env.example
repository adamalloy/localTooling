# Copy to .env and fill in.

# Required for LLM analysis (civiclens: summaries, topic/stance extraction,
# alignment scoring. biopunk_media: video summary + proposed-idea extraction).
# Shared by both tools in this repo — one key.
ANTHROPIC_API_KEY=

# Optional — required only for speaker diarization (who-said-what) during video
# transcription. Get a token at https://huggingface.co/settings/tokens and accept
# terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# Optional overrides — see civiclens/config.py for defaults.
# CIVICLENS_DATA_DIR=./data
# CIVICLENS_DATABASE_URL=sqlite:///./data/civiclens.db
# CIVICLENS_ANALYSIS_MODEL=claude-opus-5
# CIVICLENS_WHISPER_MODEL=large-v3
# CIVICLENS_WHISPER_DEVICE=cpu
# CIVICLENS_WHISPER_COMPUTE_TYPE=int8
# CIVICLENS_LEGISTAR_CLIENT=oakland

# BIOPUNK_MEDIA_DATA_DIR=./data/biopunk
# BIOPUNK_MEDIA_DATABASE_URL=sqlite:///./data/biopunk/biopunk_media.db
# BIOPUNK_MEDIA_ANALYSIS_MODEL=claude-opus-5
# BIOPUNK_MEDIA_WHISPER_MODEL=large-v3
# BIOPUNK_MEDIA_WHISPER_DEVICE=cpu
# BIOPUNK_MEDIA_WHISPER_COMPUTE_TYPE=int8
